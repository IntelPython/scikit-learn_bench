{
    "INCLUDE": ["../common/sklearn.json", "../common/hdbscan.json"],
    "PARAMETERS_SETS": {
        "sklearnex[cpu,gpu] implementations": [
            {
                "algorithm": {
                    "library": "sklearnex",
                    "device": "cpu"
                }
            },
            {
                "algorithm": {
                    "library": "sklearnex",
                    "device": "gpu",
                    "sklearn_context": {
                        "array_api_dispatch": true
                    }
                },
                "data": {
                    "format": "dpnp",
                    "order": "C"
                }
            }
        ],
        "sklearnex gpu implementation": {
            "algorithm": {
                "library": "sklearnex",
                "device": "gpu",
                "sklearn_context": {
                    "array_api_dispatch": true
                }
            },
            "data": {
                "format": "dpnp",
                "order": "C"
            }
        },
        "boundaries limits": {
            "bench": {
                "n_runs": 3,
                "time_limit": 600
            }
        },
        "blobs n_samples [stock-friendly brute]": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": "[RANGE]mul:1000:32000:2",
                    "n_features": 8,
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "blobs n_samples [large brute]": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": "[RANGE]mul:64000:128000:2",
                    "n_features": 8,
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "blobs n_samples [gpu-only brute]": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": "[RANGE]mul:256000:1024000:2",
                    "n_features": 8,
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "blobs n_samples [stock-friendly tree]": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": "[RANGE]mul:1000:128000:2",
                    "n_features": 8,
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "blobs n_samples [large tree]": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": "[RANGE]mul:256000:4096000:2",
                    "n_features": 8,
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "blobs n_features": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": 50000,
                    "n_features": "[RANGE]pow:2:1:8",
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "blobs n_features [large tree]": {
            "data": {
                "source": "make_blobs",
                "generation_kwargs": {
                    "centers": 20,
                    "n_samples": 200000,
                    "n_features": "[RANGE]pow:2:2:6",
                    "cluster_std": 2.0,
                    "random_state": 42
                },
                "split_kwargs": {
                    "ignore": true
                }
            }
        },
        "both dtypes": {
            "data": {
                "dtype": ["float32", "float64"]
            }
        },
        "other metrics": {
            "algorithm": {
                "estimator_params": {
                    "metric": ["manhattan", "chebyshev"]
                }
            }
        }
    },
    "TEMPLATES": {
        "boundaries n_samples [brute]": {
            "SETS": [
                "sklearn-ex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "sklearn hdbscan parameters",
                "hdbscan brute method",
                "blobs n_samples [stock-friendly brute]",
                "boundaries limits"
            ]
        },
        "boundaries n_samples [brute, large]": {
            "SETS": [
                "sklearnex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "hdbscan brute method",
                "blobs n_samples [large brute]",
                "boundaries limits"
            ]
        },
        "boundaries n_samples [brute, gpu only]": {
            "SETS": [
                "sklearnex gpu implementation",
                "common hdbscan parameters",
                "hdbscan brute method",
                "blobs n_samples [gpu-only brute]",
                "boundaries limits"
            ]
        },
        "boundaries n_samples [kd_tree]": {
            "SETS": [
                "sklearn-ex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "sklearn hdbscan parameters",
                "hdbscan kd_tree method",
                "blobs n_samples [stock-friendly tree]",
                "boundaries limits"
            ]
        },
        "boundaries n_samples [kd_tree, large]": {
            "SETS": [
                "sklearnex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "hdbscan kd_tree method",
                "blobs n_samples [large tree]",
                "boundaries limits"
            ]
        },
        "boundaries n_features": {
            "SETS": [
                "sklearn-ex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "sklearn hdbscan parameters",
                "hdbscan all methods",
                "blobs n_features",
                "boundaries limits"
            ]
        },
        "boundaries n_features [kd_tree, large]": {
            "SETS": [
                "sklearnex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "hdbscan kd_tree method",
                "blobs n_features [large tree]",
                "boundaries limits"
            ]
        },
        "boundaries dtypes": {
            "SETS": [
                "sklearnex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "hdbscan all methods",
                "blobs n_features",
                "both dtypes",
                "boundaries limits"
            ]
        },
        "boundaries metrics": {
            "SETS": [
                "sklearn-ex[cpu,gpu] implementations",
                "common hdbscan parameters",
                "sklearn hdbscan parameters",
                "hdbscan kd_tree method",
                "blobs n_samples [stock-friendly brute]",
                "other metrics",
                "boundaries limits"
            ]
        }
    }
}
